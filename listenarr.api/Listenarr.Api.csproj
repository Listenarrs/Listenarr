<?xml version='1.0' encoding='utf-8'?>
<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <Version>1.0.6</Version>
    <AssemblyVersion>1.0.6</AssemblyVersion>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <DefaultItemExcludes>$(DefaultItemExcludes);bin\**;bin/**;artifacts\**;artifacts/**;docker-publish\**;docker-publish/**;publish\**;publish/**</DefaultItemExcludes>
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
    <GenerateTargetFrameworkAttribute>false</GenerateTargetFrameworkAttribute>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>  
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <NoWarn>$(NoWarn);1591</NoWarn>
  </PropertyGroup>
  
  <ItemGroup>
    <PackageReference Include="Asp.Versioning.Mvc" />
    <PackageReference Include="Asp.Versioning.Mvc.ApiExplorer" />
    <PackageReference Include="AsyncKeyedLock" />
    <PackageReference Condition="!$([MSBuild]::IsTargetFrameworkCompatible('$(TargetFramework)', 'net9.0'))" Include="Backport.System.Threading.Lock" />
    <PackageReference Include="Microsoft.Data.Sqlite.Core" />
    <PackageReference Include="Microsoft.EntityFrameworkCore" />
    <PackageReference Include="SixLabors.ImageSharp" />
    <PackageReference Include="Microsoft.Extensions.Http.Polly" />
    <PackageReference Include="Polly" />
    <PackageReference Include="TagLibSharp" />
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" />
    <PackageReference Include="Swashbuckle.AspNetCore" />
    <PackageReference Include="HtmlAgilityPack" />
    <PackageReference Include="Serilog.AspNetCore" />
    <PackageReference Include="Serilog.Sinks.File" />
  </ItemGroup>

  <ItemGroup>
    <Compile Remove="Services\AudibleSearchService.cs" />
    <Compile Remove="Services\AmazonMetadataService.cs" />
    <Compile Remove="Services\AudibleMetadataService.cs" />
    <Compile Remove="Services\Search\FallbackScraper.cs" />
    <Compile Remove="Services\Extractors\AmazonMetadataExtractors.cs" />
    <Compile Remove="Services\Extractors\SharedMetadataExtractors.cs" />
    
    <Compile Remove="publish\**\*.cs" />
    <Compile Remove="publish/**/*.cs" />
    <Compile Remove="docker-publish\**\*.cs" />
    <Compile Remove="docker-publish/**/*.cs" />
  </ItemGroup>

  
  <PropertyGroup>
    
    <SkipFrontendBuild Condition="'$(SkipFrontendBuild)'==''">false</SkipFrontendBuild>
  
    <FrontendDir>$(MSBuildProjectDirectory)\..\fe</FrontendDir>
    <FrontendDist>$(FrontendDir)\dist</FrontendDist>
    
    
    <ToolsDir>$(MSBuildProjectDirectory)\..\tools</ToolsDir>
    <DiscordBotDir>$(ToolsDir)\discord-bot</DiscordBotDir>
    <ToolsExclude>$(DiscordBotDir)\**\node_modules\**;$(DiscordBotDir)\**\.env;$(DiscordBotDir)\**\.env.*</ToolsExclude>
  </PropertyGroup>

  <Target Name="BuildFrontend" BeforeTargets="Publish" Condition="'$(SkipFrontendBuild)'!='true'">
    <Message Importance="high" Text="Building frontend (fe) at $(FrontendDir)" />

    
    <Exec WorkingDirectory="$(FrontendDir)" Command="npm ci" />
    <Exec WorkingDirectory="$(FrontendDir)" Command="npm run build" />

    
    <MakeDir Directories="$(MSBuildProjectDirectory)\wwwroot" Condition="!Exists('$(MSBuildProjectDirectory)\wwwroot')" />
    <RemoveDir Directories="$(MSBuildProjectDirectory)\wwwroot\assets" Condition="Exists('$(MSBuildProjectDirectory)\wwwroot\assets')" />

    <ItemGroup>
      <StaleFrontendDebugFiles Include="$(MSBuildProjectDirectory)\wwwroot\*.map;$(MSBuildProjectDirectory)\wwwroot\stats.html" />
      <FrontendDistFiles Include="$(FrontendDist)\**\*.*" />
    </ItemGroup>

    <Delete Files="@(StaleFrontendDebugFiles)" />
    <Copy SourceFiles="@(FrontendDistFiles)" DestinationFiles="@(FrontendDistFiles-&gt;'$(MSBuildProjectDirectory)\\wwwroot\\%(RecursiveDir)%(Filename)%(Extension)')" SkipUnchangedFiles="true" />
  </Target>

  
  <Target Name="CopyFrontendToPublish" AfterTargets="Publish" Condition="'$(SkipFrontendBuild)'!='true'">
    <Message Importance="high" Text="Copying frontend dist to publish folder ($(PublishDir)wwwroot)" />
    <ItemGroup>
      <FrontendDistFilesForPublish Include="$(FrontendDist)\**\*.*" />
    </ItemGroup>

    <Copy SourceFiles="@(FrontendDistFilesForPublish)" DestinationFiles="@(FrontendDistFilesForPublish-&gt;'$(PublishDir)wwwroot\\%(RecursiveDir)%(Filename)%(Extension)')" SkipUnchangedFiles="false" />
  </Target>

  
  <Target Name="CopyFrontendToProjectPublishFolder" AfterTargets="CopyFrontendToPublish" Condition="'$(SkipFrontendBuild)'!='true'">
    <Message Importance="high" Text="Also copying frontend dist to $(MSBuildProjectDirectory)\publish\wwwroot (fallback)" />
    <ItemGroup>
      <FrontendDistFilesForPublishFallback Include="$(FrontendDist)\**\*.*" />
    </ItemGroup>

    <MakeDir Directories="$(MSBuildProjectDirectory)\publish\wwwroot" Condition="!Exists('$(MSBuildProjectDirectory)\publish\wwwroot')" />

    <Copy SourceFiles="@(FrontendDistFilesForPublishFallback)" DestinationFiles="@(FrontendDistFilesForPublishFallback-&gt;'$(MSBuildProjectDirectory)\\publish\\wwwroot\\%(RecursiveDir)%(Filename)%(Extension)')" SkipUnchangedFiles="false" />
  </Target>

  
  <Target Name="CopyFrontendToNestedPublishFolder" AfterTargets="CopyFrontendToProjectPublishFolder" Condition="'$(SkipFrontendBuild)'!='true'">
    <Message Importance="high" Text="Copying frontend dist to $(MSBuildProjectDirectory)\publish\publish\wwwroot (nested publish)" />
    <ItemGroup>
      <FrontendDistFilesForNestedPublish Include="$(FrontendDist)\**\*.*" />
    </ItemGroup>

    <MakeDir Directories="$(MSBuildProjectDirectory)\publish\publish\wwwroot" Condition="!Exists('$(MSBuildProjectDirectory)\publish\publish\wwwroot')" />

    <Copy SourceFiles="@(FrontendDistFilesForNestedPublish)" DestinationFiles="@(FrontendDistFilesForNestedPublish-&gt;'$(MSBuildProjectDirectory)\\publish\\publish\\wwwroot\\%(RecursiveDir)%(Filename)%(Extension)')" SkipUnchangedFiles="false" />
  </Target>

  
  <ItemGroup>
    
    <Content Remove="tools\**" />
    <None Remove="tools\**" />
  </ItemGroup>
  
  
  <ItemGroup>
    <ProjectReference Include="..\listenarr.domain\Listenarr.Domain.csproj" />
    <ProjectReference Include="..\listenarr.application\Listenarr.Application.csproj" />
    <ProjectReference Include="..\listenarr.infrastructure\Listenarr.Infrastructure.csproj" />
  </ItemGroup>
  
  <ItemGroup>
    <InternalsVisibleTo Include="Listenarr.Tests" />
  </ItemGroup>
  
  <Target Name="CopyToolsToPublish" AfterTargets="Publish">
    <Message Importance="high" Text="Copying Discord bot from $(DiscordBotDir) to $(PublishDir)tools\discord-bot" />
    
    <ItemGroup>
      <ToolFiles Include="$(DiscordBotDir)\**\*.*" Exclude="$(ToolsExclude)" />
    </ItemGroup>
    
    
    <MakeDir Directories="$(PublishDir)tools\discord-bot" Condition="!Exists('$(PublishDir)tools\discord-bot')" />
    
    
    <Copy SourceFiles="@(ToolFiles)" DestinationFiles="@(ToolFiles-&gt;'$(PublishDir)tools\discord-bot\%(RecursiveDir)%(Filename)%(Extension)')" SkipUnchangedFiles="false" />
    
    <Message Importance="high" Text="Discord bot copied to $(PublishDir)tools\discord-bot" />
  </Target>
  
  
  <Target Name="CopyToolsToProjectPublishFolder" AfterTargets="CopyToolsToPublish">
    <Message Importance="high" Text="Also copying Discord bot to $(MSBuildProjectDirectory)\publish\tools\discord-bot (fallback)" />
    
    <ItemGroup>
      <ToolFilesForFallback Include="$(DiscordBotDir)\**\*.*" Exclude="$(ToolsExclude)" />
    </ItemGroup>
    
    <MakeDir Directories="$(MSBuildProjectDirectory)\publish\tools\discord-bot" Condition="!Exists('$(MSBuildProjectDirectory)\publish\tools\discord-bot')" />
    
    <Copy SourceFiles="@(ToolFilesForFallback)" DestinationFiles="@(ToolFilesForFallback-&gt;'$(MSBuildProjectDirectory)\publish\tools\discord-bot\%(RecursiveDir)%(Filename)%(Extension)')" SkipUnchangedFiles="false" />
  </Target>
  
  <Target Name="CopyToolsToNestedPublishFolder" AfterTargets="CopyToolsToProjectPublishFolder">
    <Message Importance="high" Text="Copying Discord bot to $(MSBuildProjectDirectory)\publish\publish\tools\discord-bot (nested publish)" />
    
    <ItemGroup>
      <ToolFilesForNested Include="$(DiscordBotDir)\**\*.*" Exclude="$(ToolsExclude)" />
    </ItemGroup>
    
    <MakeDir Directories="$(MSBuildProjectDirectory)\publish\publish\tools\discord-bot" Condition="!Exists('$(MSBuildProjectDirectory)\publish\publish\tools\discord-bot')" />
    
    <Copy SourceFiles="@(ToolFilesForNested)" DestinationFiles="@(ToolFilesForNested-&gt;'$(MSBuildProjectDirectory)\publish\publish\tools\discord-bot\%(RecursiveDir)%(Filename)%(Extension)')" SkipUnchangedFiles="false" />
  </Target>

</Project>