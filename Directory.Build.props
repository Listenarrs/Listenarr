<Project>

	<PropertyGroup>
		<SixLaborsLicenseKey Condition="'$(SixLaborsLicenseKey)' == '' and '$(SIXLABORS_LICENSE_KEY)' != ''">$(SIXLABORS_LICENSE_KEY)</SixLaborsLicenseKey>
		<SixLaborsLicenseFile Condition="'$(SixLaborsLicenseFile)' == '' and Exists('$(MSBuildThisFileDirectory)licenses/sixlabors.lic')">$(MSBuildThisFileDirectory)licenses/sixlabors.lic</SixLaborsLicenseFile>
		<TargetFramework>net10.0</TargetFramework>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
		<LangVersion>latest</LangVersion>
		<GenerateDocumentationFile>true</GenerateDocumentationFile>
		<NoWarn>$(NoWarn);CS1591</NoWarn>
		<DefaultItemExcludes>$(DefaultItemExcludes);**\artifacts\**;**\.tmp\**;**\obj2\**</DefaultItemExcludes>
	</PropertyGroup>

</Project>
