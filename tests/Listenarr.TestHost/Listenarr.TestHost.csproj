<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\listenarr.api\Listenarr.Api.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- One folder per provider: Metadata/Fixtures/Audible/B008DFUGCQ.json is "Listenarr.TestHost.Fixtures/Audible/B008DFUGCQ.json". -->
    <EmbeddedResource Include="Metadata\Fixtures\**\*" Exclude="Metadata\Fixtures\**\*.md"
                      LogicalName="Listenarr.TestHost.Fixtures/%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>
</Project>
