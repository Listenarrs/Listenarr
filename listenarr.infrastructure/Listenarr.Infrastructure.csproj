<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\listenarr.domain\Listenarr.Domain.csproj" />
    <ProjectReference Include="..\listenarr.application\Listenarr.Application.csproj" />
  </ItemGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <PackageReference Include="AsyncKeyedLock" />
    <PackageReference Include="Microsoft.EntityFrameworkCore" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" />
    <PackageReference Include="SharpCompress" />
    <PackageReference Include="HtmlAgilityPack" />
    <PackageReference Include="Openur.FFprobeStatic" />
    <PackageReference Include="Serilog.Sinks.File" />
    <PackageReference Include="Microsoft.Extensions.Http.Polly" />
    <PackageReference Include="Polly" />
    <PackageReference Include="BencodeNET" />
    <PackageReference Include="TagLibSharp" />
    <PackageReference Include="SixLabors.ImageSharp" />
  </ItemGroup>

  <ItemGroup>
    <!-- The licence texts and source notice for the packaged ffprobe travel with it into every build and publish output. -->
    <None Include="..\licenses\ffprobe\**" LinkBase="licenses\ffprobe" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Listenarr.Tests" />
    <InternalsVisibleTo Include="Listenarr.FakeProviders" />
    <EmbeddedResource Include="Search\Matching\release-annotations.json" LogicalName="Listenarr.Infrastructure.Search.Matching.release-annotations.json" />
  </ItemGroup>

</Project>
