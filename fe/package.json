{
  "name": "listenarr-fe",
  "version": "1.0.6",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "version:sync": "node ../scripts/sync-fe-version-from-csproj.mjs",
    "predev": "npm run version:sync",
    "prebuild": "npm run version:sync",
    "pretest:unit": "npm run version:sync",
    "prelint": "npm run version:sync",
    "prelint:check": "npm run version:sync",
    "prelint:fix": "npm run version:sync",
    "dev": "vite",
    "dev:full": "concurrently \"npm run dev:api\" \"npm run dev\" --names \"API,WEB\" --prefix-colors \"blue,green\"",
    "dev:api": "cd ../listenarr.api && dotnet run",
    "build": "run-p type-check \"build-only {@}\" --",
    "preview": "vite preview",
    "test": "vitest",
    "test:unit": "vitest run --reporter=dot --silent",
    "prepare": "cypress install",
    "postinstall": "patch-package && npm run version:sync",
    "test:e2e": "start-server-and-test preview http://localhost:4173 'cypress run --e2e'",
    "test:e2e:dev": "start-server-and-test 'vite dev --port 4173' http://localhost:4173 'cypress open --e2e'",
    "build-only": "vite build",
    "build:analyze": "vite build --mode analysis",
    "type-check": "vue-tsc --build tsconfig.app.json",
    "lint": "npm run lint:eslint && npm run lint:vue-handlers",
    "lint:check": "npm run lint:eslint && npm run lint:vue-handlers",
    "lint:eslint": "eslint .",
    "lint:vue-handlers": "node scripts/check-vue-template-handlers.mjs src",
    "lint:fix": "eslint . --fix",
    "format:prettier": "prettier --write src/",
    "format:prettier:check": "prettier --check src/",
    "format:check": "npm run format:prettier:check && npm run lint:vue-handlers",
    "format": "npm run format:prettier && npm run lint:vue-handlers"
  },
  "dependencies": {
    "@material/material-color-utilities": "^0.4.0",
    "@microsoft/signalr": "^10.0.0",
    "@phosphor-icons/vue": "^2.2.1",
    "@vueuse/core": "^14.1.0",
    "minimist": "^1.2.8",
    "pinia": "^3.0.3",
    "qs": "^6.15.1",
    "vue": "^3.5.33",
    "vue-router": "^5.0.6",
    "web-vitals": "^5.2.0"
  },
  "devDependencies": {
    "@tsconfig/node22": "^22.0.5",
    "@types/jsdom": "^28.0.1",
    "@types/node": "^25.6.0",
    "@vitejs/plugin-vue": "^6.0.6",
    "@vitest/eslint-plugin": "^1.6.16",
    "@vue/compiler-sfc": "^3.5.33",
    "@vue/eslint-config-prettier": "^10.2.0",
    "@vue/eslint-config-typescript": "^14.6.0",
    "@vue/test-utils": "^2.4.8",
    "@vue/tsconfig": "^0.9.1",
    "concurrently": "^9.2.1",
    "cypress": "^15.14.1",
    "eslint": "^10.2.1",
    "eslint-plugin-cypress": "^6.3.1",
    "eslint-plugin-vue": "^10.9.0",
    "jiti": "^2.5.1",
    "jsdom": "^29.0.2",
    "npm-run-all2": "^8.0.4",
    "patch-package": "^8.0.1",
    "prettier": "^3.8.3",
    "rollup-plugin-visualizer": "^7.0.1",
    "start-server-and-test": "^3.0.0",
    "typescript": "^6.0.3",
    "vite": "^8.0.10",
    "vitest": "^4.1.5",
    "vue-tsc": "^3.2.7"
  },
  "overrides": {
    "ajv": "^8.18.0",
    "eslint": {
      "ajv": "^6.14.0"
    }
  }
}
