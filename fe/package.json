{
  "name": "listenarr-fe",
  "version": "1.7.2",
  "private": true,
  "type": "module",
  "engines": {
    "node": "^26.12.1"
  },
  "scripts": {
    "version:sync": "node ../scripts/sync-fe-version-from-csproj.mjs",
    "predev": "npm run version:sync",
    "prebuild": "npm run version:sync",
    "pretest:unit": "npm run version:sync",
    "prelint": "npm run version:sync",
    "prelint:check": "npm run version:sync",
    "prelint:fix": "npm run version:sync",
    "dev": "vite",
    "dev:full": "concurrently \"npm run dev:api\" \"npm run dev\" --names \"API,WEB\" --prefix-colors \"blue,green\"",
    "dev:api": "cd ../listenarr.api && dotnet run",
    "build": "run-p type-check \"build-only {@}\" --",
    "preview": "vite preview",
    "test": "vitest",
    "test:build-config": "node --test scripts/check-vite-production-build.mjs",
    "test:unit": "vitest run --reporter=dot --silent",
    "prepare": "cypress install",
    "postinstall": "patch-package && npm run version:sync",
    "test:e2e": "npm run test:e2e:fullstack",
    "test:e2e:fullstack": "node ../scripts/e2e/run-cypress.mjs",
    "test:e2e:read-only": "node ../scripts/e2e/run-cypress.mjs read-only",
    "test:e2e:write": "node ../scripts/e2e/run-cypress.mjs write",
    "test:integration:cypress": "start-server-and-test 'vite dev --host 127.0.0.1 --port 5173 --strictPort' http://127.0.0.1:5173 'cypress run --e2e --config-file cypress.integration.config.ts'",
    "test:integration:cypress:open": "start-server-and-test 'vite dev --host 127.0.0.1 --port 5173 --strictPort' http://127.0.0.1:5173 'cypress open --e2e --config-file cypress.integration.config.ts'",
    "api-types:generate": "node ../scripts/generate-api-types.mjs",
    "api-types:check": "node ../scripts/generate-api-types.mjs --check --no-build",
    "type-check:cypress": "tsc --noEmit -p cypress/tsconfig.json",
    "build-only": "vite build",
    "build:analyze": "vite build --mode analysis",
    "type-check": "vue-tsc --build tsconfig.app.json",
    "lint": "npm run lint:eslint && npm run lint:vue-handlers",
    "lint:check": "npm run lint:eslint && npm run lint:vue-handlers",
    "lint:eslint": "eslint .",
    "lint:vue-handlers": "node scripts/check-vue-template-handlers.mjs src",
    "lint:fix": "eslint . --fix",
    "format:prettier": "prettier --write src/",
    "format:prettier:check": "prettier --check src/",
    "format:check": "npm run format:prettier:check && npm run lint:vue-handlers",
    "format": "npm run format:prettier && npm run lint:vue-handlers"
  },
  "dependencies": {
    "@material/material-color-utilities": "^0.4.0",
    "@microsoft/signalr": "^10.0.0",
    "@phosphor-icons/vue": "^2.2.1",
    "@vueuse/core": "^14.3.0",
    "minimist": "^1.2.8",
    "pinia": "^3.0.4",
    "qs": "^6.16.0",
    "vue": "^3.5.44",
    "vue-router": "^5.1.0",
    "web-vitals": "^6.2.3"
  },
  "devDependencies": {
    "@hey-api/openapi-ts": "^0.99.0",
    "@tsconfig/node26": "^26.0.1",
    "@types/jsdom": "^30.0.0",
    "@types/node": "^26.6.5",
    "@vitejs/plugin-vue": "^6.0.7",
    "@vitest/eslint-plugin": "^1.6.20",
    "@vue/compiler-sfc": "^3.5.44",
    "@vue/eslint-config-prettier": "^10.2.0",
    "@vue/eslint-config-typescript": "^14.8.0",
    "@vue/test-utils": "^2.4.11",
    "@vue/tsconfig": "^0.9.1",
    "concurrently": "^10.0.3",
    "cypress": "^15.17.0",
    "eslint": "^10.4.1",
    "eslint-plugin-cypress": "^6.4.1",
    "eslint-plugin-vue": "^10.9.2",
    "jiti": "^2.7.0",
    "jsdom": "^30.1.3",
    "npm-run-all2": "^9.0.1",
    "patch-package": "^8.0.1",
    "prettier": "^3.8.4",
    "rollup-plugin-visualizer": "^7.0.1",
    "start-server-and-test": "^3.0.11",
    "typescript": "^6.0.3",
    "vite": "^8.1.6",
    "vitest": "^4.1.12",
    "vue-tsc": "^3.3.13"
  },
  "overrides": {
    "ajv": "^8.18.0",
    "eslint": {
      "ajv": "^6.14.0"
    }
  }
}
